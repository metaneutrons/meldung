# Patterns are deliberately UNANCHORED, so that they bite at every level.
# A leading slash stops matching as soon as a subproject appears.

# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Coverage
coverage/
.nyc_output/

# Environment and state
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*

# Keys and certificates
*.pem

# Deployment
.vercel/

# Data directory of the file persistence driver
data/

# Editor and operating system
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
